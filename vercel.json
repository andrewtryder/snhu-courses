{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "redirects": [
    {
      "source": "/",
      "destination": "https://snhu-tools.vercel.app/courses",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "https://snhu-tools.vercel.app/about",
      "permanent": true
    },
    {
      "source": "/course/:id",
      "destination": "https://snhu-tools.vercel.app/courses/:id",
      "permanent": true
    },
    {
      "source": "/course/:id/:path*",
      "destination": "https://snhu-tools.vercel.app/courses/:id/:path*",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "https://snhu-tools.vercel.app/courses",
      "permanent": true
    },
    {
      "source": "/courses/:path*",
      "destination": "https://snhu-tools.vercel.app/courses/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://snhu-tools.vercel.app/courses",
      "permanent": true
    }
  ]
}
