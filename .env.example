# PostgreSQL connection used by the application and local catalog tools.
POSTGRES_URL=

# Required only while the optional Vercel cron route is enabled.
CRON_SECRET=

# Secret for POST /api/revalidate — used by CircleCI or desktop sync after catalog promotion.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Optional monitoring.
HONEYBADGER_API_KEY=
NEXT_PUBLIC_HONEYBADGER_API_KEY=

# Optional public metadata.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LAST_UPDATED=
